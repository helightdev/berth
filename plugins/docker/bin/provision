#!/usr/bin/env python3
"""Creates the container for a berth host, with systemd as PID 1 and an SSH
server, and Compose projects for deployments.

Version 2 of berth's provisioner protocol: one JSON request on stdin, one JSON
answer on stdout, progress on stderr. `logs` writes the log on stdout instead.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

PACKAGE = Path(__file__).resolve().parent.parent
IMAGE_NAME = 'berth-docker-host'
SSH_WAIT = 180
PROTOCOL = 2
SYSBOX = 'sysbox-runc'
RUNTIMES = ('privileged', 'sysbox')
# Rows of a listing an action answers with, at most.
ROWS = 60
# How many of the latest lines `logs` gives when the request does not say.
LOG_LINES = 100

# Runs inside the container with the public keys on stdin. It does not depend on
# the image, so a custom one needs only sh, useradd, sudo and sshd.
SETUP = r'''
set -e
user=$1
id "$user" >/dev/null 2>&1 || useradd --create-home --shell /bin/bash "$user"
usermod --password '*' "$user"
getent group sudo >/dev/null && usermod --append --groups sudo "$user"
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$user" > /etc/sudoers.d/90-berth-access
chmod 0440 /etc/sudoers.d/90-berth-access
mkdir -p /etc/ssh/provided-keys /etc/ssh/sshd_config.d /run/sshd
cat > "/etc/ssh/provided-keys/$user"
chmod 0644 "/etc/ssh/provided-keys/$user"
[ -f /etc/ssh/sshd_config.d/10-provided.conf ] || printf '%s\n' \
  'AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/provided-keys/%u' \
  'PasswordAuthentication no' > /etc/ssh/sshd_config.d/10-provided.conf
ssh-keygen -A >/dev/null
# sshd failed its first starts for want of host keys, which trips the start limit.
systemctl reset-failed ssh 2>/dev/null || true
systemctl enable ssh >/dev/null 2>&1 || true
systemctl restart ssh
'''


class Failure(Exception):
    pass


def say(text):
    print(text, file=sys.stderr, flush=True)


def tail(text, lines=8):
    return ' | '.join([line for line in text.strip().splitlines() if line.strip()][-lines:])


def failure(what, output):
    """The error for a docker command that failed, from the last lines it wrote."""
    message = tail(output or '')
    if re.search(r'Cannot connect to the Docker daemon|error during connect|permission denied while trying to connect', message):
        return Failure(f'the Docker daemon is not reachable: {message}')
    if re.search(r"'compose' is not a docker command|unknown command:? .*compose", message):
        return Failure('Docker Compose is not installed where berth runs: deployments need the docker compose plugin')
    return Failure(f'{what} failed: {message}')


def stream(argv, env, what, cwd=None, mask=lambda text: text):
    """Copies what a command writes to standard output as it comes, until it ends
    or whoever reads stops."""
    sys.stdout.flush()
    try:
        process = subprocess.Popen(argv, env=env, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, errors='replace')
    except FileNotFoundError:
        raise Failure('docker is not installed or not on the PATH')
    try:
        for line in process.stdout:
            sys.stdout.write(mask(line))
            sys.stdout.flush()
    except BrokenPipeError:
        process.kill()
        process.wait()
        # Nothing more can be written, so the closed pipe must not fail the exit either.
        sys.stdout = open(os.devnull, 'w')
        return
    if process.wait() != 0:
        raise Failure(f'{what} ended with {process.returncode}')


class Docker:
    def __init__(self, endpoint):
        self.env = dict(os.environ)
        if endpoint:
            self.env['DOCKER_HOST'] = endpoint

    def run(self, *args, input=None, check=True, merge=False):
        try:
            done = subprocess.run(['docker', *args], env=self.env, input=input, text=True, errors='replace',
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT if merge else subprocess.PIPE)
        except FileNotFoundError:
            raise Failure('docker is not installed or not on the PATH')
        if check and done.returncode != 0:
            raise failure(f'docker {args[0]}', done.stderr or done.stdout)
        return done

    def inspect(self, name):
        """The container as a dict, or None when there is none."""
        done = self.run('container', 'inspect', name, check=False)
        if done.returncode == 0:
            return json.loads(done.stdout)[0]
        if 'No such' in done.stderr:
            return None
        self.run('container', 'inspect', name)

    def names(self, *filters):
        args = ['ps', '--all', '--format', '{{.Names}}']
        for item in filters:
            args += ['--filter', item]
        return [line for line in self.run(*args).stdout.splitlines() if line.strip()]

    def json_lines(self, *args):
        """What a command with --format '{{json .}}' printed, one object a line."""
        found = []
        for line in self.run(*args, '--format', '{{json .}}').stdout.splitlines():
            if line.strip():
                try:
                    found.append(json.loads(line))
                except ValueError:
                    pass
        return found

    def runtimes(self):
        """The names of the runtimes the engine has."""
        done = self.run('info', '--format', '{{json .Runtimes}}')
        try:
            return sorted(json.loads(done.stdout or '{}') or {})
        except ValueError:
            return []

    def version(self):
        done = self.run('version', '--format', '{{json .}}')
        try:
            return json.loads(done.stdout or '{}') or {}
        except ValueError:
            return {}

    def where(self):
        return self.env.get('DOCKER_HOST') or 'the local Docker'


def valid_name(host):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', host or ''):
        raise Failure(f'{host!r} is not a name a container can have')


UNITS = {'': 1, 'b': 1, 'k': 1024, 'kb': 1024, 'kib': 1024, 'm': 1024**2, 'mb': 1024**2, 'mib': 1024**2,
         'g': 1024**3, 'gb': 1024**3, 'gib': 1024**3}


def parse_cpus(text):
    if not re.fullmatch(r'\d+(\.\d+)?', text) or float(text) <= 0:
        raise Failure(f'cpus must be a positive number such as 2 or 1.5, not {text!r}')
    return text


def parse_memory(text):
    found = re.fullmatch(r'(\d+(?:\.\d+)?)\s*([A-Za-z]*)', text)
    unit = found.group(2).lower() if found else None
    # Docker counts k, m and g in powers of 1024, so GiB and g mean the same size.
    if unit not in UNITS or int(float(found.group(1)) * UNITS[unit]) <= 0:
        raise Failure(f'memory must be a size such as 4GiB, 512MiB or 4g, not {text!r}')
    return str(int(float(found.group(1)) * UNITS[unit]))


def settings(request):
    arguments = request.get('arguments') or {}
    host = request.get('host') or ''
    return {
        'docker': Docker((arguments.get('host') or '').strip()),
        'image': (arguments.get('image') or '').strip(),
        'port': (arguments.get('ssh_port') or '').strip(),
        'address': (arguments.get('publish_address') or '').strip() or '127.0.0.1',
        'volume': (arguments.get('volume') or '').strip() or f'berth-{host}-data',
        'cpus': (arguments.get('cpus') or '').strip(),
        'memory': (arguments.get('memory') or '').strip(),
        'keep': (arguments.get('keep_volume') or 'no').strip().lower() == 'yes',
        'runtime': (arguments.get('runtime') or 'privileged').strip().lower(),
    }


def container_name(request):
    host = request.get('host') or ''
    valid_name(host)
    return f'berth-{host}'


def labelled(info):
    return bool(info and 'berth-host' in (info.get('Config', {}).get('Labels') or {}))


def container_address(info):
    for network in (info.get('NetworkSettings', {}).get('Networks') or {}).values():
        if network.get('IPAddress'):
            return network['IPAddress']
    return ''


def where(cfg, info):
    """The address and port berth reaches the container on."""
    if cfg['port']:
        return cfg['address'], int(cfg['port'])
    return container_address(info), 22


def package_version():
    return json.loads((PACKAGE / 'package.json').read_text())['version']


def ensure_image(cfg, again=False):
    docker = cfg['docker']
    if cfg['image']:
        return cfg['image']
    tag = f'{IMAGE_NAME}:{package_version()}'
    if not again and docker.run('image', 'inspect', tag, check=False).returncode == 0:
        return tag
    say(f'Building {tag}, once. This takes a few minutes.')
    try:
        build = subprocess.run(
            ['docker', 'build', '--tag', tag, '-'], env=docker.env,
            input=(PACKAGE / 'Dockerfile').read_text(), text=True,
            stdout=sys.stderr, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise Failure('docker is not installed or not on the PATH')
    sys.stderr.write(build.stderr)
    if build.returncode != 0:
        raise Failure(f'building the image failed: {tail(build.stderr)}')
    return tag


def wait_for(docker, name, command, what, seconds):
    deadline = time.monotonic() + seconds
    while True:
        if docker.run('exec', name, *command, check=False).returncode == 0:
            return
        if time.monotonic() > deadline:
            raise Failure(f'{what} did not come up in {seconds} seconds in {name}')
        time.sleep(1)


def wait_for_ssh(docker, name):
    wait_for(docker, name, ['systemctl', 'is-active', '--quiet', 'ssh'], 'sshd', SSH_WAIT)


def wait_for_systemd(docker, name):
    wait_for(docker, name, ['sh', '-c', 'state=$(systemctl is-system-running 2>/dev/null); '
                            'case "$state" in running|degraded) exit 0;; esac; exit 1'],
             'systemd', SSH_WAIT)


def setup_access(docker, name, access):
    user = (access or {}).get('user') or ''
    keys = [key.strip() for key in (access or {}).get('public_keys') or [] if key.strip()]
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
        raise Failure(f'{user!r} is not a user name the container can have')
    if not keys:
        raise Failure('no public keys to authorise')
    wait_for_systemd(docker, name)
    docker.run('exec', '-i', name, 'sh', '-c', SETUP, 'sh', user, input='\n'.join(keys) + '\n')
    wait_for_ssh(docker, name)


def isolation(cfg):
    """How the container gets the rights systemd and the role need: the
    arguments of docker run for the runtime asked for."""
    if cfg['runtime'] not in RUNTIMES:
        raise Failure(f'runtime is privileged or sysbox, not {cfg["runtime"]!r}')
    if cfg['runtime'] == 'sysbox':
        if SYSBOX not in cfg['docker'].runtimes():
            raise Failure(f'{cfg["docker"].where()} has no {SYSBOX} runtime. Install Sysbox on the Docker '
                          'host (see the plugin\'s guide), or create the machine with runtime=privileged')
        # Sysbox gives the container a cgroup tree of its own, and mounts what systemd needs.
        return ['--runtime', SYSBOX]
    # systemd needs a cgroup tree of its own that it can write, and the role sets up a
    # firewall. Docker gives both only to a privileged container.
    return ['--privileged', '--cgroupns', 'private', '--tmpfs', '/run', '--tmpfs', '/run/lock']


def create(request):
    cfg = settings(request)
    docker = cfg['docker']
    name = container_name(request)
    cpus = parse_cpus(cfg['cpus']) if cfg['cpus'] else ''
    memory = parse_memory(cfg['memory']) if cfg['memory'] else ''
    isolated = isolation(cfg)
    labels = request.get('labels') or {}
    token = request.get('token') or labels.get('berth-instance') or ''
    if not token:
        raise Failure('the request carries no token')
    found = docker.names(f'label=berth-instance={token}')
    existing = docker.inspect(name)
    if existing:
        mine = (existing.get('Config', {}).get('Labels') or {})
        if not labelled(existing) or mine.get('berth-instance') != token:
            raise Failure(f'a container named {name} exists that berth did not create for this host')
    elif found:
        name = found[0]
        existing = docker.inspect(name)
    if existing:
        if not existing.get('State', {}).get('Running'):
            say(f'Starting {name}.')
            docker.run('start', name)
        wait_for_ssh(docker, name)
        info = docker.inspect(name)
        address, port = where(cfg, info)
        return {'id': name, 'address': address, 'port': port}

    image = ensure_image(cfg)
    # Created here, not by run, so that destroy can tell berth's volume from one the user named.
    if docker.run('volume', 'inspect', cfg['volume'], check=False).returncode != 0:
        docker.run('volume', 'create', '--label', f'berth-host={request["host"]}', cfg['volume'])
    args = ['run', '--detach', '--name', name, '--hostname', request['host'],
            '--restart', 'unless-stopped', '--stop-signal', 'SIGRTMIN+3', *isolated,
            '--volume', f'{cfg["volume"]}:/srv/agent']
    for key in ('berth-host', 'berth-instance'):
        if labels.get(key):
            args += ['--label', f'{key}={labels[key]}']
    if not labels.get('berth-host'):
        args += ['--label', f'berth-host={request["host"]}']
    if not labels.get('berth-instance'):
        args += ['--label', f'berth-instance={token}']
    if cfg['port']:
        if not cfg['port'].isdigit() or not 0 < int(cfg['port']) < 65536:
            raise Failure(f'{cfg["port"]!r} is not a port')
        bind = '127.0.0.1' if cfg['address'] in ('127.0.0.1', 'localhost', '::1') else '0.0.0.0'
        args += ['--publish', f'{bind}:{cfg["port"]}:22']
    if cpus:
        args += ['--cpus', cpus]
    if memory:
        args += ['--memory', memory]
    args += [image, '/sbin/init']
    say(f'Creating {name}.')
    docker.run(*args)
    try:
        setup_access(docker, name, request.get('access'))
    except Failure:
        docker.run('rm', '--force', name, check=False)
        raise
    address, port = where(cfg, docker.inspect(name))
    return {'id': name, 'address': address, 'port': port}


def identify(request):
    name = request.get('id') or ''
    if not name:
        raise Failure('the request names no container')
    return name


def engine_status(cfg):
    """What the engine is, for the provisioner's own status."""
    docker = cfg['docker']
    version = docker.version()
    server = version.get('Server') or {}
    runtimes = docker.runtimes()
    made = docker.names('label=berth-host')
    details = [
        {'label': 'Endpoint', 'value': docker.where()},
        {'label': 'Engine', 'value': server.get('Version') or 'unknown'},
        {'label': 'API', 'value': server.get('ApiVersion') or ''},
        {'label': 'System', 'value': f'{server.get("Os") or "?"}/{server.get("Arch") or "?"}'},
        {'label': 'Runtimes', 'value': ', '.join(runtimes)},
        {'label': 'Machines berth made', 'value': str(len(made))},
    ]
    return {
        'state': 'ready',
        'message': f'Docker {server.get("Version") or ""} answers at {docker.where()}'.replace('  ', ' '),
        'details': details,
        'values': {'runtime': ['privileged', 'sysbox'] if SYSBOX in runtimes else ['privileged']},
    }


def status(request):
    cfg = settings(request)
    if not request.get('id'):
        return engine_status(cfg)
    info = cfg['docker'].inspect(identify(request))
    if info is None:
        return {'state': 'gone'}
    if info.get('State', {}).get('Running'):
        answer = {'state': 'running'}
        address, _ = where(cfg, info)
        if address:
            answer['address'] = address
        return answer
    return {'state': 'stopped'}


def ours(docker, name):
    info = docker.inspect(name)
    if info is not None and not labelled(info):
        raise Failure(f'{name} was not created by berth')
    return info


def start(request):
    cfg = settings(request)
    name = identify(request)
    if ours(cfg['docker'], name) is None:
        raise Failure(f'{name} does not exist')
    cfg['docker'].run('start', name)
    wait_for_ssh(cfg['docker'], name)
    return {}


def stop(request):
    cfg = settings(request)
    name = identify(request)
    if ours(cfg['docker'], name) is None:
        raise Failure(f'{name} does not exist')
    cfg['docker'].run('stop', '--time', '30', name)
    return {}


def destroy(request):
    cfg = settings(request)
    docker = cfg['docker']
    name = identify(request)
    if ours(docker, name) is not None:
        docker.run('rm', '--force', '--volumes', name)
    if cfg['keep']:
        return {}
    volume = docker.run('volume', 'inspect', cfg['volume'], check=False)
    if volume.returncode == 0:
        found = json.loads(volume.stdout)[0].get('Labels') or {}
        if 'berth-host' in found:
            docker.run('volume', 'rm', cfg['volume'])
        else:
            say(f'Volume {cfg["volume"]} was not created by berth and is kept.')
    return {}


def list_all(request):
    docker = settings(request)['docker']
    kind = request.get('kind') or ''
    resources = []
    if kind in ('', 'machine'):
        resources += machines(docker)
    if kind in ('', 'deployment'):
        resources += deployments(docker)
    return {'resources': resources}


def machines(docker):
    resources = []
    for name in docker.names('label=berth-host'):
        info = docker.inspect(name)
        if info is None:
            continue
        host = (info['Config'].get('Labels') or {}).get('berth-host', '')
        running = info.get('State', {}).get('Running')
        resources.append({'id': name, 'kind': 'machine', 'name': host, 'host': host,
                          'state': 'running' if running else 'stopped'})
    return resources


def change(request):
    """New limits for a machine that runs on: its CPUs and memory."""
    cfg = settings(request)
    docker = cfg['docker']
    name = identify(request)
    if ours(docker, name) is None:
        raise Failure(f'{name} does not exist')
    args = []
    if cfg['cpus']:
        args += ['--cpus', parse_cpus(cfg['cpus'])]
    if cfg['memory']:
        memory = parse_memory(cfg['memory'])
        # Docker refuses a memory limit above the swap limit it set beside the old one.
        args += ['--memory', memory, '--memory-swap', str(int(memory) * 2)]
    if args:
        say(f'Changing the limits of {name}.')
        docker.run('update', *args, name)
    running = (docker.inspect(name) or {}).get('State', {}).get('Running')
    return {'state': 'running' if running else 'stopped'}


def logs(request):
    """The container's console output on standard output, until it ends or berth stops it,
    or its journal when the console has nothing."""
    cfg = settings(request)
    docker = cfg['docker']
    name = identify(request)
    if ours(docker, name) is None:
        raise Failure(f'{name} does not exist')
    lines = str(int(request.get('tail') or LOG_LINES))
    done = docker.run('logs', '--tail', lines, name, check=False, merge=True)
    if done.returncode != 0:
        raise Failure(f'docker logs failed: {tail(done.stdout or "")}')
    if (done.stdout or '').strip():
        if not request.get('follow'):
            sys.stdout.write(done.stdout)
            return None
        stream(['docker', 'logs', '--tail', lines, '--follow', name], docker.env, 'docker logs')
        return None
    # Without a terminal systemd has no console to print to, but its journal has the same.
    journal = ['journalctl', '--quiet', '--boot', '--lines', lines, '--output', 'cat', '--no-pager']
    if not request.get('follow'):
        done = docker.run('exec', name, *journal, check=False)
        sys.stdout.write(done.stdout if done.returncode == 0 else '')
        return None
    stream(['docker', 'exec', name, *journal, '--follow'], docker.env, 'journalctl')
    return None


def counted(count, word):
    return f'{count} {word}' + ('' if count == 1 else 's')


def act_engine(cfg, arguments):
    status = engine_status(cfg)
    return {'message': status['message'], 'details': status['details']}


def act_images(cfg, arguments):
    images = cfg['docker'].json_lines('image', 'ls')
    rows = [{'label': f'{image.get("Repository")}:{image.get("Tag")}',
             'value': f'{image.get("Size", "")} · {image.get("ID", "")}'} for image in images[:ROWS]]
    message = f'{counted(len(images), "image")} at {cfg["docker"].where()}'
    if len(images) > ROWS:
        message += f', the first {ROWS} shown'
    return {'message': message, 'details': rows}


def berth_volumes(docker):
    """The volumes berth made, each with the containers that use it."""
    found = []
    for volume in docker.json_lines('volume', 'ls', '--filter', 'label=berth-host'):
        name = volume.get('Name') or ''
        if not name:
            continue
        users = docker.names(f'volume={name}')
        labels = dict(part.split('=', 1) for part in (volume.get('Labels') or '').split(',') if '=' in part)
        found.append((name, labels.get('berth-host', ''), users))
    return found


def act_volumes(cfg, arguments):
    volumes = berth_volumes(cfg['docker'])
    rows = [{'label': name, 'value': f'for {host or "?"} · ' + (f'used by {", ".join(users)}' if users else 'unused')}
            for name, host, users in volumes]
    return {'message': f'{counted(len(volumes), "volume")} berth made at {cfg["docker"].where()}', 'details': rows}


def act_build(cfg, arguments):
    tag = ensure_image(dict(cfg, image=''), again=True)
    return {'message': f'Built {tag} at {cfg["docker"].where()}'}


def act_prune(cfg, arguments):
    docker = cfg['docker']
    current = f'{IMAGE_NAME}:{package_version()}'
    removed = []
    for image in docker.json_lines('image', 'ls', IMAGE_NAME):
        tag = f'{image.get("Repository")}:{image.get("Tag")}'
        if tag == current or image.get('Repository') != IMAGE_NAME:
            continue
        if docker.names(f'ancestor={image.get("ID")}'):
            say(f'{tag} is kept: a container uses it.')
            continue
        say(f'Removing {tag}.')
        if docker.run('image', 'rm', tag, check=False).returncode == 0:
            removed.append(tag)
    if (arguments.get('volumes') or 'no').strip().lower() == 'yes':
        for name, _, users in berth_volumes(docker):
            if users:
                continue
            say(f'Removing the volume {name}.')
            if docker.run('volume', 'rm', name, check=False).returncode == 0:
                removed.append(f'volume {name}')
    if not removed:
        return {'message': 'Nothing berth left behind is there'}
    return {'message': f'Removed {len(removed)}', 'details': [{'label': item, 'value': 'removed'} for item in removed]}


ACTIONS = {'engine': act_engine, 'images': act_images, 'volumes': act_volumes,
           'build': act_build, 'prune': act_prune}


# Deployments: one Compose project each, named after the deployment.

PROJECT = r'[a-z0-9][a-z0-9_-]*'
VARIABLE = r'[A-Za-z_][A-Za-z0-9_]*'
# The project is named by -p and its file comes on stdin, never from the environment berth runs in.
INHERITED = ('COMPOSE_FILE', 'COMPOSE_PROJECT_NAME', 'COMPOSE_PATH_SEPARATOR', 'COMPOSE_PROFILES')
LABELS = ('berth-resource', 'berth-token')


def valid_project(name):
    if not isinstance(name, str) or not re.fullmatch(PROJECT, name):
        raise Failure(f'{name!r} is not a Compose project name: it takes lowercase letters, digits, - and _, '
                      'and starts with a letter or digit')
    return name


def json_objects(text):
    """What --format json printed: one array, or one object a line, as Compose versions differ."""
    text = (text or '').strip()
    if not text:
        return []
    try:
        found = json.loads(text)
        return [item for item in (found if isinstance(found, list) else [found]) if isinstance(item, dict)]
    except ValueError:
        pass
    found = []
    for line in text.splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if isinstance(item, dict):
            found.append(item)
    return found


def label_map(text):
    if isinstance(text, dict):
        return text
    return dict(part.split('=', 1) for part in (text or '').split(',') if '=' in part)


def feed(pipe, text):
    try:
        pipe.write(text)
        pipe.close()
    except (BrokenPipeError, OSError):
        pass


class Compose:
    """docker compose for one project, with the secrets berth resolved in its environment and nowhere else."""

    def __init__(self, request, project):
        self.docker = settings(request)['docker']
        self.project = valid_project(project)
        self.env = {key: value for key, value in self.docker.env.items() if key not in INHERITED}
        self.secrets = []
        environment = request.get('environment') or {}
        if not isinstance(environment, dict):
            raise Failure('environment must be an object of variables')
        for key, value in environment.items():
            if not re.fullmatch(VARIABLE, key):
                raise Failure(f'{key!r} is not a name an environment variable can have')
            if key.startswith(('DOCKER_', 'COMPOSE_')):
                raise Failure(f'{key} would change how docker compose runs: give the secret another name')
            value = '' if value is None else str(value)
            self.env[key] = value
            if value:
                self.secrets.append(value)
        self.secrets.sort(key=len, reverse=True)
        arguments = request.get('arguments') or {}
        self.keep = (arguments.get('keep_volumes') or 'no').strip().lower() == 'yes'

    def where(self):
        return self.docker.where()

    def mask(self, text):
        for secret in self.secrets:
            text = text.replace(secret, '***')
        return text

    def argv(self, args, files=()):
        argv = ['docker', 'compose', '-p', self.project]
        for name in files:
            argv += ['-f', name]
        return argv + list(args)

    def run(self, *args, spec=None, labels=None, services=(), progress=False, check=True):
        """Runs a subcommand in an empty directory, so that no compose.yaml or .env of whoever
        runs berth comes in. The spec goes on standard input, and the labels in a file of their own."""
        with tempfile.TemporaryDirectory(prefix='berth-compose-') as empty:
            files = ['-'] if spec is not None else []
            if labels and services:
                override = Path(empty) / 'berth-labels.json'
                override.write_text(json.dumps({'services': {name: {'labels': labels} for name in services}}))
                override.chmod(0o600)
                files.append(str(override))
            try:
                process = subprocess.Popen(
                    self.argv(args, files), env=self.env, cwd=empty, text=True, errors='replace',
                    stdin=subprocess.PIPE if spec is not None else subprocess.DEVNULL, stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT if progress else subprocess.PIPE)
            except FileNotFoundError:
                raise Failure('docker is not installed or not on the PATH')
            if progress:
                if spec is not None:
                    threading.Thread(target=feed, args=(process.stdin, spec), daemon=True).start()
                seen = []
                for line in process.stdout:
                    line = self.mask(line)
                    sys.stderr.write(line)
                    sys.stderr.flush()
                    seen = (seen + [line])[-20:]
                process.wait()
                out = err = ''.join(seen)
            else:
                out, err = process.communicate(spec)
        if check and process.returncode != 0:
            raise failure(f'docker compose {args[0]}', self.mask(err or out))
        return subprocess.CompletedProcess(process.args, process.returncode, out, err)

    def containers(self):
        return json_objects(self.run('ps', '--all', '--format', 'json').stdout)

    def ours(self):
        """The project's containers. A project with containers but none of berth's labels is someone else's."""
        rows = self.containers()
        if rows and not any('berth-resource' in label_map(row.get('Labels')) for row in rows):
            raise Failure(f'the Compose project {self.project} was not created by berth')
        return rows

    def existing(self):
        rows = self.ours()
        if not rows:
            raise Failure(f'the Compose project {self.project} has no containers at {self.where()}')
        return rows

    def up(self, spec, labels):
        if not isinstance(spec, str) or not spec.strip():
            raise Failure('the request carries no Compose file')
        services = [line.strip() for line in self.run('config', '--services', spec=spec).stdout.splitlines()
                    if line.strip()]
        say(f'Bringing up {self.project} at {self.where()}.')
        self.run('up', '-d', '--remove-orphans', spec=spec, labels=labels, services=services, progress=True)
        return project_state(self.containers())


def running(row):
    return (row.get('State') or '').lower() == 'running'


def project_state(rows):
    if not rows:
        return {'state': 'gone'}
    up = [row for row in rows if running(row)]
    if len(up) == len(rows):
        return {'state': 'running'}
    if not up:
        return {'state': 'stopped'}
    down = sorted({row.get('Service') or row.get('Name') or '?' for row in rows if not running(row)})
    return {'state': 'running', 'message': f'{", ".join(down)} not running'}


def project_labels(request, compose, rows=()):
    """berth's labels for the project's containers: the request's, else those its containers have."""
    given = request.get('labels') or {}
    labels = {key: given[key] for key in LABELS if given.get(key)}
    if request.get('token'):
        labels.setdefault('berth-token', request['token'])
    for row in rows:
        found = label_map(row.get('Labels'))
        for key in LABELS:
            if found.get(key):
                labels.setdefault(key, found[key])
    labels.setdefault('berth-resource', compose.project)
    return labels


def deployment_id(request):
    if not request.get('id'):
        raise Failure('the request names no Compose project')
    return request['id']


def deployment_create(request):
    compose = Compose(request, request.get('name'))
    answer = compose.up(request.get('spec'), project_labels(request, compose))
    return {'id': compose.project, **answer}


def deployment_change(request):
    compose = Compose(request, deployment_id(request))
    rows = compose.ours()
    return compose.up(request.get('spec'), project_labels(request, compose, rows))


def deployment_status(request):
    return project_state(Compose(request, deployment_id(request)).containers())


def deployment_destroy(request):
    compose = Compose(request, deployment_id(request))
    if not compose.ours():
        say(f'{compose.project} has no containers left; removing what else it has.')
    args = ['down', '--remove-orphans'] + ([] if compose.keep else ['--volumes'])
    done = compose.run(*args, progress=True, check=False)
    if done.returncode != 0 and compose.containers():
        raise failure('docker compose down', done.stderr)
    return {}


def deployment_start(request):
    compose = Compose(request, deployment_id(request))
    compose.existing()
    compose.run('start', progress=True)
    return {}


def deployment_stop(request):
    compose = Compose(request, deployment_id(request))
    compose.existing()
    compose.run('stop', progress=True)
    return {}


def deployment_logs(request):
    compose = Compose(request, deployment_id(request))
    lines = int(request.get('tail') or 0)
    args = ['logs', '--no-color', '--tail', str(lines) if lines > 0 else 'all']
    if request.get('follow'):
        args.append('--follow')
    with tempfile.TemporaryDirectory(prefix='berth-compose-') as empty:
        stream(compose.argv(args), compose.env, 'docker compose logs', cwd=empty, mask=compose.mask)
    return None


def deployments(docker):
    """The Compose projects whose containers carry berth's labels, each with its state."""
    done = docker.run('ps', '--all', '--filter', 'label=berth-resource',
                      '--format', '{{.Label "com.docker.compose.project"}}\t{{.State}}')
    projects = {}
    for line in done.stdout.splitlines():
        name, _, state = line.partition('\t')
        if name.strip():
            projects.setdefault(name.strip(), []).append({'State': state.strip()})
    return [{'id': name, 'kind': 'deployment', 'name': name, 'host': '', 'state': project_state(rows)['state']}
            for name, rows in sorted(projects.items())]


def act_services(request, compose, arguments):
    rows = compose.ours()
    details = [{'label': row.get('Service') or row.get('Name') or '?',
                'value': ' · '.join(part for part in (row.get('State'), row.get('Status')) if part)}
               for row in rows[:ROWS]]
    up = len([row for row in rows if running(row)])
    return {'message': f'{counted(len(rows), "service")} of {compose.project}, {up} running', 'details': details}


def act_restart(request, compose, arguments):
    rows = compose.existing()
    compose.run('restart', progress=True)
    return {'message': f'Restarted {counted(len(rows), "container")} of {compose.project}'}


def act_pull(request, compose, arguments):
    rows = compose.existing()
    spec = request.get('spec')
    if not isinstance(spec, str) or not spec.strip():
        raise Failure('the request carries no Compose file')
    say(f'Pulling the images of {compose.project}.')
    compose.run('pull', spec=spec, progress=True)
    answer = compose.up(spec, project_labels(request, compose, rows))
    return {'message': f'Pulled the images of {compose.project} and recreated what they changed',
            'details': [{'label': 'State', 'value': answer['state']}]}


DEPLOYMENT_ACTIONS = {'services': act_services, 'restart': act_restart, 'pull': act_pull}

DEPLOYMENT_VERBS = {'create': deployment_create, 'status': deployment_status, 'start': deployment_start,
                    'stop': deployment_stop, 'destroy': deployment_destroy, 'change': deployment_change,
                    'logs': deployment_logs}


def act(request):
    action = request.get('action') or {}
    name = action.get('name') or ''
    arguments = action.get('arguments') or {}
    if request.get('id'):
        kind = request.get('kind') or 'machine'
        if kind != 'deployment':
            raise Failure(f'a {kind} has no actions')
        if name not in DEPLOYMENT_ACTIONS:
            raise Failure(f'there is no action {name!r} of a deployment; there are {", ".join(DEPLOYMENT_ACTIONS)}')
        return DEPLOYMENT_ACTIONS[name](request, Compose(request, request['id']), arguments)
    if name not in ACTIONS:
        raise Failure(f'there is no action {name!r}; there are {", ".join(ACTIONS)}')
    return ACTIONS[name](settings(request), arguments)


VERBS = {'create': create, 'status': status, 'start': start, 'stop': stop,
         'destroy': destroy, 'list': list_all, 'change': change, 'logs': logs, 'act': act}


def handler(verb, request):
    """The function for a verb: a deployment's own, or the machine's and the provisioner's."""
    about_one = verb == 'create' or (verb != 'act' and request.get('id'))
    if request.get('kind') == 'deployment' and verb in DEPLOYMENT_VERBS and about_one:
        return DEPLOYMENT_VERBS[verb]
    return VERBS[verb]


def main():
    try:
        verb = sys.argv[1] if len(sys.argv) > 1 else ''
        if verb not in VERBS:
            raise Failure(f'unknown verb {verb!r}')
        request = json.load(sys.stdin)
        if request.get('version') != PROTOCOL:
            raise Failure(f'this plugin speaks version {PROTOCOL} of the provisioner protocol, '
                          f'not {request.get("version")!r}: update berth')
        answer = handler(verb, request)(request)
    except Failure as error:
        say(f'docker/container: {error}')
        return 1
    except (json.JSONDecodeError, KeyError) as error:
        say(f'docker/container: bad request: {error}')
        return 1
    if answer is not None:
        print(json.dumps(answer))
    return 0


if __name__ == '__main__':
    sys.exit(main())
