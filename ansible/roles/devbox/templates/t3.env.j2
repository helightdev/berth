T3CODE_HOST={{ devbox_bind }}
T3CODE_PORT=3773
DISPLAY=:1
XAUTHORITY={{ devbox_home }}/.config/devbox.Xauthority
XDG_RUNTIME_DIR=/run/user/{{ devbox_uid }}
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ devbox_uid }}/bus
DISABLE_AUTOUPDATER=1
PATH={{ devbox_tool_path }}
DEVBOX_SOFTWARE_RENDERING={{ '1' if devbox_software_rendering else '0' }}
{% if devbox_software_rendering %}
LIBGL_ALWAYS_SOFTWARE=1
GALLIUM_DRIVER=llvmpipe
__GLX_VENDOR_LIBRARY_NAME=mesa
VK_DRIVER_FILES={{ devbox_lvp_icd }}
{% endif %}
