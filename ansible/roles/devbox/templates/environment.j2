# Managed shell-compatible environment. Runtime values are not credentials.
export DISPLAY=:1
export XAUTHORITY={{ devbox_home }}/.config/devbox.Xauthority
export XDG_RUNTIME_DIR={{ '/tmp/devbox-runtime' if devbox_profile == 'container' else '/run/user/' ~ devbox_uid }}
export DEVBOX_BIND={{ devbox_bind }}
export DEVBOX_GEOMETRY={{ devbox_geometry }}
export DEVBOX_PROFILE={{ devbox_profile }}
export DISABLE_AUTOUPDATER=1
export PATH={{ devbox_tool_path }}
export DEVBOX_SOFTWARE_RENDERING={{ '1' if devbox_software_rendering else '0' }}
{% if devbox_software_rendering %}
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export __GLX_VENDOR_LIBRARY_NAME=mesa
export VK_DRIVER_FILES={{ devbox_lvp_icd }}
{% endif %}

export DEVBOX_COCKPIT={{ '1' if devbox_install_cockpit and devbox_profile != 'container' else '0' }}
export DEVBOX_USER={{ devbox_user }}
export DEVBOX_PASSWORDLESS_SUDO={{ '1' if devbox_agent_passwordless_sudo else '0' }}
# What the owner installed with berth for this account, if anything.
if [ -r "$HOME/.config/devbox/secrets.env" ]; then . "$HOME/.config/devbox/secrets.env"; fi
