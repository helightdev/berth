{
  "components": {
    "schemas": {
      "Done": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "From": {
        "description": "Who did something, as berthd saw it.",
        "properties": {
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "session": {
            "type": [
              "string",
              "null"
            ]
          },
          "uid": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "level",
          "uid"
        ],
        "type": "object"
      },
      "HostInfo": {
        "properties": {
          "address": {
            "description": "Its SSH address.",
            "type": "string"
          },
          "api": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "description": "Why it is not reachable.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "version": {
            "description": "The version of its berthd.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "address",
          "reachable"
        ],
        "type": "object"
      },
      "Inbox": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/InboxMessage"
            },
            "type": "array"
          },
          "next": {
            "description": "Pass as `before` for older ones, when there are more.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      },
      "InboxMessage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Message"
          },
          {
            "properties": {
              "done": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "seq": {
                "description": "The order it was taken in; what `before` counts in.",
                "format": "int64",
                "type": "integer"
              }
            },
            "required": [
              "host",
              "done",
              "seq"
            ],
            "type": "object"
          }
        ],
        "description": "A stored message: the host's message with where it came from."
      },
      "JobInfo": {
        "properties": {
          "ended": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "host": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "started": {
            "type": "string"
          },
          "what": {
            "description": "What it does: `apply`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "host",
          "what",
          "started"
        ],
        "type": "object"
      },
      "Keep": {
        "enum": [
          "none",
          "last",
          "log"
        ],
        "type": "string"
      },
      "KvEntry": {
        "properties": {
          "key": {
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "updated": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "key",
          "value",
          "revision",
          "updated"
        ],
        "type": "object"
      },
      "KvList": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/KvEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "KvWritten": {
        "properties": {
          "key": {
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "revision"
        ],
        "type": "object"
      },
      "Level": {
        "enum": [
          "host",
          "agent"
        ],
        "type": "string"
      },
      "Message": {
        "properties": {
          "body": {},
          "from": {
            "$ref": "#/components/schemas/From"
          },
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "keep": {
            "$ref": "#/components/schemas/Keep"
          },
          "time": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "topic",
          "body",
          "keep",
          "from",
          "time"
        ],
        "type": "object"
      },
      "Output": {
        "properties": {
          "data_b64": {
            "type": "string"
          },
          "ended": {
            "description": "Nothing more will come.",
            "type": "boolean"
          },
          "first_offset": {
            "description": "Where what is still kept begins, when the start was dropped.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "lines": {
            "description": "The same as text, when read by lines.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_line": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "next_offset": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "description": "The offset this answer starts at.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "data_b64",
          "offset",
          "next_offset",
          "next_line",
          "ended"
        ],
        "type": "object"
      },
      "Version": {
        "properties": {
          "api": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "mode": {
            "description": "`system` or `single`.",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "api"
        ],
        "type": "object"
      }
    }
  },
