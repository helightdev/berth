[Unit]
Description=berth service {{ item.name }}
After=berthd.service
Wants=berthd.service

[Service]
{% if item.user == 'root' %}
ExecStart=/bin/bash {{ devbox_service_dir }}/{{ item.name | replace('/', '-') }}.sh
{% else %}
User={{ devbox_user }}
WorkingDirectory={{ devbox_home }}
ExecStart=/usr/local/bin/agent-env /bin/bash {{ devbox_service_dir }}/{{ item.name | replace('/', '-') }}.sh
{% endif %}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
